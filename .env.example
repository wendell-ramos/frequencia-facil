APP_ENV=local
APP_BASE_PATH=/frequencia-facil
APP_PORT=8080
APP_IMAGE=frequenciafacil-app:local

DB_HOST=127.0.0.1
DB_PORT=3306
MYSQL_DATABASE=frequenciafacil
MYSQL_USER=frequencia_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Producao: use o arquivo Docker Secret; nao copie a senha para este .env.
MYSQL_PASSWORD_FILE=
MYSQL_APP_PASSWORD_FILE=./secrets/mysql_app_password
BACKEND_NETWORK_NAME=frequenciafacil_backend
INGRESS_NETWORK_NAME=frequenciafacil_ingress

# Nome do volume local. Na VPS, informe obrigatoriamente o nome do volume existente.
MYSQL_VOLUME_NAME=frequenciafacil_mysql_data
